{
	"appId": "com.helmsportslabs.golfhelm",
	"appName": "Helm Sports Labs",
	"webDir": "public",
	"server": {
		"url": "https://helmsportslabs.com/golf/dashboard",
		"cleartext": false,
		"errorPath": "offline.html",
		"allowNavigation": [
			"helmsportslabs.com",
			"*.helmsportslabs.com",
			"www.helmsportslabs.com"
		]
	},
	"ios": {
		"allowsLinkPreview": false,
		"scrollEnabled": true,
		"webContentsDebuggingEnabled": false,
		"preferredContentMode": "mobile",
		"contentInset": "never",
		"appendUserAgent": "HelmSportsLabsApp",
		"backgroundColor": "#EDE9DF"
	},
	"android": {
		"appendUserAgent": "HelmSportsLabsApp",
		"allowMixedContent": false,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#EDE9DF"
	},
	"plugins": {
		"Keyboard": {
			"resize": "ionic",
			"resizeOnFullScreen": true,
			"scrollAssist": true,
			"scrollPadding": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 10000,
			"backgroundColor": "#EDE9DF",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PushNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
