<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Channel the FCM SDK posts to when a message carries no explicit
             channel. Must match MainActivity.DEFAULT_CHANNEL_ID, which creates
             it — declaring a channel here without creating it means every
             notification is silently dropped on API 26+. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="helm_default" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 (API 33) made notifications a RUNTIME permission. Without
         this declaration the OS silently drops every notification and the
         permission prompt never appears — no error, nothing in logcat, the
         feature simply does not exist for the user. `cap add android` does not
         add it, so it has to be declared here explicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets a scheduled local notification survive a reboot, so a practice or
         tee-time reminder set for tomorrow still fires if the phone restarts
         overnight. Required by @capacitor/local-notifications. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- @capacitor/network reads connectivity to drive the offline banner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
