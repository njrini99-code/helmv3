-              >
-                {pageNum}
-              </Button>
-            );
-          })}
-        </div>
-
-        <IconButton variant="default" aria-label="Next"
-          type="button"
-          onClick={() => onPageChange(page + 1)}
-          disabled={page >= totalPages}
-          className={cn(
-            'p-2 rounded-lg transition-colors',
