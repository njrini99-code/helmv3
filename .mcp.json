{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=qmnssrrolpinvwjjnufo&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "supabase-readonly": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=qmnssrrolpinvwjjnufo&read_only=true&features=docs%2Cdatabase%2Cdebugging%2Cdevelopment%2Cnotebooks%2Cstorage"
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "next-devtools-mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "chrome-devtools-mcp",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "supabase-staging-ro": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ybmwektreyrwjscxlogv&read_only=true&features=database%2Cdocs%2Cdebugging"
    },
    "playwright-webkit": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "playwright",
        "mcp",
        "--browser",
        "webkit",
        "--device",
        "iPhone 17 Pro",
        "--isolated",
        "--output-dir",
        "${HOME}/helm-audit-runs/mcp"
      ]
    },
    "safari-native": {
      "type": "stdio",
      "command": "/usr/bin/safaridriver",
      "args": [
        "--mcp"
      ]
    }
  }
}
