# =============================================================================
# Helm Sports Labs - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Production/Remote Supabase (Recommended for deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Development (Optional - comment out production URLs above)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Application Configuration (REQUIRED)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# RESERVED — not read anywhere in src/ today (verified 2026-07-09). Safe to
# set, has no effect until a call site is added.
NEXT_PUBLIC_APP_NAME=Helm Sports Labs

# RESERVED — not read anywhere in src/ today (verified 2026-07-09). There is
# no dev-mode gate in the app; this var currently does nothing.
NEXT_PUBLIC_DEV_MODE=false

# -----------------------------------------------------------------------------
# Tambo AI (for GolfHelm generative UI)
# -----------------------------------------------------------------------------
# RESERVED — aspirational. No `tambo` package.json dependency and zero Tambo
# references anywhere in src/ (verified 2026-07-09); the generative-UI
# integration this section name implies has not been built.
NEXT_PUBLIC_TAMBO_API_KEY=your-tambo-api-key-here

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (REQUIRED for Production)
# -----------------------------------------------------------------------------
# Get these from: https://helm-xs.sentry.io/settings/projects/javascript-nextjs/keys/
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ORG=helm-xs
SENTRY_PROJECT=javascript-nextjs
# Dedicated read token for Helm Bridge issue/stats queries.
# Required scopes: org:read, project:read, event:read.
SENTRY_READ_TOKEN=your-sentry-read-token-here
# CI/source-map upload token. Helm Bridge only falls back to this when
# SENTRY_READ_TOKEN is absent and the token has the read scopes above.
SENTRY_AUTH_TOKEN=your-auth-token-here

# -----------------------------------------------------------------------------
# Datadog RUM + Browser Logs (Optional — src/lib/datadog/index.ts)
# -----------------------------------------------------------------------------
# This module runs entirely client-side, so every var it reads MUST be
# NEXT_PUBLIC_-prefixed — un-prefixed vars are stripped at build time and
# read as undefined in the browser, silently falling back to defaults.
# Get application ID / client token from: https://app.datadoghq.com/organization-settings/rum
NEXT_PUBLIC_DD_APPLICATION_ID=YOUR_APPLICATION_ID
NEXT_PUBLIC_DD_CLIENT_TOKEN=your-datadog-client-token-here
# Datadog site (defaults to 'datadoghq.com'; use 'datadoghq.eu' etc for other regions).
# NEXT_PUBLIC_DD_SITE=datadoghq.com
# Service name tag (defaults to 'helm-sports-labs').
# NEXT_PUBLIC_DD_SERVICE=helm-sports-labs
# Env tag override. Leave unset to reuse NEXT_PUBLIC_VERCEL_ENV (production/
# preview/development) — Next.js inlines that one automatically, see next.config.mjs.
# NEXT_PUBLIC_DD_ENV=production

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CAMPS=true
# NEXT_PUBLIC_ENABLE_MESSAGING=true

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Svix webhook signing secret. Verifies BOTH the outbound tracking webhook
# (/api/webhooks/resend — delivery/open/click/bounce/complaint/unsubscribe) and
# the inbound reply webhook (/api/webhooks/resend-inbound — email.received).
# Get from: https://resend.com/webhooks → your webhook → signing secret.
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- CRM cold-outreach From/identity (admin send-email + sequence cron) ---
# Primary From for CRM sends and the founder signature block. Falls back to
# 'Helm Sports Labs <admin@helmsportslabs.com>' if unset.
HELM_FROM_EMAIL=Helm Sports Labs <admin@helmsportslabs.com>
# Reply-To for cold outreach (defaults to HELM_FROM_EMAIL when unset).
HELM_REPLY_TO=admin@helmsportslabs.com
# Bare domain used to build links + the founder signature footer (no scheme).
HELM_DOMAIN=helmsportslabs.com
# Absolute URL of the logo embedded in the branded email footer.
HELM_LOGO_URL=https://helmsportslabs.com/helm-golf-logo-transparent.png
# Human signature line printed under the logo in outbound CRM email.
HELM_FOUNDER_LINE=Leah Potter & Nick Rini
# mailto: address used for the RFC 8058 List-Unsubscribe mailto fallback.
HELM_UNSUB_EMAIL=admin@helmsportslabs.com

# --- One-click unsubscribe (RFC 8058) token signing ---
# HMAC key for the List-Unsubscribe token in cold outreach. MUST be set to a
# strong random value in production (e.g. `openssl rand -hex 32`) AND match
# scripts/process-sequence-batch.mjs. The code defaults to the hardcoded string
# 'helm-sports-unsub-v1' so it works out-of-the-box in dev — but leaving that
# default in prod makes unsubscribe tokens forgeable (anyone can suppress any
# coach by guessing the public UUID). Always override in prod + preview. (G8)
CRM_UNSUB_SECRET=replace-with-strong-random-value-in-prod

# -----------------------------------------------------------------------------
# Gmail API direct send (OPTIONAL — for cold outreach via the real mailbox)
# -----------------------------------------------------------------------------
# When ALL THREE of GMAIL_SA_CLIENT_EMAIL + GMAIL_SA_PRIVATE_KEY + GMAIL_SEND_AS
# are set, the CRM "Gmail" buttons SEND cold email straight through your Google
# Workspace mailbox (Gmail API), not Resend — which lands in Primary far more
# reliably for 1:1 cold outreach. Leave them unset and nothing changes: the
# "Gmail" buttons keep opening a pre-filled compose tab (the existing flow).
#
# One-time setup (Google Cloud service account + Workspace domain-wide
# delegation, ~15 min): see docs/setup/gmail-send-setup.md.
#
# Service-account email (…@<project>.iam.gserviceaccount.com).
GMAIL_SA_CLIENT_EMAIL=
# The SA's PEM private key. Paste the whole "-----BEGIN PRIVATE KEY-----…"
# block; \n-escaped (single-line) is fine — the code restores the newlines.
GMAIL_SA_PRIVATE_KEY=
# Mailbox to impersonate / send as (must be a real Workspace user).
GMAIL_SEND_AS=admin@helmsportslabs.com
# Optional display name on the From header (defaults to "Nick Rini").
HELM_FROM_NAME=Nick Rini
# Optional safety cap on Gmail-API sends per calendar day (default 50). Keep
# this conservative — bursts from a real mailbox are the #1 way to get a
# Workspace account throttled or flagged for outbound spam.
GMAIL_DAILY_CAP=50

# --- Transactional/notification From addresses (non-CRM) ---
# Generic notifications From (task reminders, CoachHelm digests foundation).
# Falls back to 'Helm Sports <notifications@helmsportslabs.com>' when unset.
FROM_EMAIL=Helm Sports <notifications@helmsportslabs.com>
# RESERVED — not read anywhere in src/ today (verified 2026-07-25). No
# team-invite.ts file exists. RESEND_COACH_DIGEST_FROM was removed with the
# coach-morning-digest cron on 2026-07-25; nothing reads it now.
# Safe to set, has no effect until a team-invite send path is built.
RESEND_TEAM_INVITE_FROM=Helm Sports <notifications@helmsportslabs.com>

# -----------------------------------------------------------------------------
# Web Push (VAPID) — used for browser push notifications
# -----------------------------------------------------------------------------
# Generate with:  npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the client; the PRIVATE key is server-only.
# Subject is the contact URL/mailto required by the Web Push spec (RFC 8292).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BD...your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:admin@helmsportslabs.com

# -----------------------------------------------------------------------------
# GrowthBook — feature flags + experiment rollout (v3)
# -----------------------------------------------------------------------------
# Get from: https://app.growthbook.io/settings/keys
# Server-evaluated; never expose the client key to the browser.
# GROWTHBOOK_API_HOST=https://cdn.growthbook.io
# GROWTHBOOK_CLIENT_KEY=sdk-your-sdk-key

# Legacy SMTP (not used — Resend is the active provider)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@helmlab.com
# SMTP_FROM_NAME=Helm Sports Labs

# -----------------------------------------------------------------------------
# Uploadthing Configuration (Optional - for file uploads)
# -----------------------------------------------------------------------------
# UPLOADTHING_SECRET=sk_live_your-secret-key
# UPLOADTHING_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# Stripe Configuration (Optional - for payments/subscriptions)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
# STRIPE_SECRET_KEY=sk_live_your-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# -----------------------------------------------------------------------------
# API Keys (Optional - for integrations)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key
# CLAUDE_API_KEY=your-claude-api-key

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# ANALYZE=false  # Set to 'true' to analyze bundle size
# NODE_ENV=production  # Automatically set by Vercel/deployment platform

# -----------------------------------------------------------------------------
# Vercel Analytics (Business Intelligence Dashboard)
# -----------------------------------------------------------------------------
# Get API token from: https://vercel.com/account/tokens
# Project ID and Team ID from: .vercel/project.json
VERCEL_API_TOKEN=your-vercel-api-token-here
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# -----------------------------------------------------------------------------
# Helm Bridge — edge→node error-capture bridge (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Shared secret checked by src/app/api/internal/log-auth-failure/route.ts and
# src/app/api/internal/log-server-error/route.ts. The edge runtime can't talk
# to Supabase directly (createAdminClient is not edge-safe), so proxy.ts and
# the edge branch of onRequestError (src/instrumentation.ts) fire-and-forget a
# POST to these routes instead, authenticated with this header value. Unset =
# both routes silently no-op (no error, no Bridge row) rather than 401-spam.
# Generate with: openssl rand -hex 32
INTERNAL_LOG_KEY=

# Opt-in: persist error_logs/admin_events rows from Vercel PREVIEW deployments
# too (production always persists regardless of this flag; see
# shouldPersistAdminTables() in src/lib/telemetry-gate.ts). Off by default —
# preview builds are usually feature branches mid-development and would
# otherwise flood the Bridge with in-progress-work noise. Set to '1' to
# rehearse the full pipeline (e.g. Bridge error-tracking QA) on a preview URL
# before it reaches production.
ADMIN_EVENTS_CAPTURE_PREVIEW=

# -----------------------------------------------------------------------------
# Helm Bridge Feedback Intake (Ben + Leah -> GitHub Issues)
# -----------------------------------------------------------------------------
# Fine-grained or classic GitHub token with issue write access to the repo.
GITHUB_ISSUES_TOKEN=github-token-with-issues-write
# Defaults to njrini99-code/helmv3 when unset.
GITHUB_ISSUES_REPO=njrini99-code/helmv3
# Private Supabase Storage bucket used for screenshot signed links.
HELM_BRIDGE_FEEDBACK_BUCKET=helm-bridge-feedback

# -----------------------------------------------------------------------------
# Cup of Helm (the 7am founder briefing — /api/cron/admin-digest)
# -----------------------------------------------------------------------------
# DEDICATED Resend key, deliberately NOT the customer-facing RESEND_API_KEY.
# Separate secret = an ops-mail leak or key rotation can never touch coach or
# player mail, and vice versa. Unset in dev/preview → the cron reports
# skipped:true rather than failing.
OPS_DIGEST_RESEND_API_KEY=
# Who gets the briefing. COMMA-SEPARATED for more than one inbox; the transport
# splits and trims, and Resend is handed an array (a raw comma string is
# rejected as one malformed address).
OPS_DIGEST_TO=admin@helmsportslabs.com,njrini99@gmail.com
# Optional From override. Defaults to "Cup of Helm <bridge@helmsportslabs.com>",
# which requires that domain to be verified in Resend.
# OPS_DIGEST_FROM=Cup of Helm <bridge@helmsportslabs.com>

# -----------------------------------------------------------------------------
# Helm Bridge Work log (PR timeline tab)
# -----------------------------------------------------------------------------
# Comma-separated GitHub logins to filter PRs (e.g. your username). Omit to show all repo PRs.
GITHUB_PR_AUTHOR_LOGINS=your-github-username
# Max PRs to fetch (default 60, max 100)
# GITHUB_PR_FETCH_LIMIT=60

# -----------------------------------------------------------------------------
# Inngest (Durable workflows — replaces scattered cron + retry loops)
# -----------------------------------------------------------------------------
# Free tier: 50K step runs/month, 5 concurrent functions.
# Sign up at https://app.inngest.com → create an app named "helmv3" →
# copy these from the app's Keys page. Local dev does not require them
# (the dev server auto-discovers /api/inngest).
# INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=signkey-prod-your-key

# -----------------------------------------------------------------------------
# Mapbox (Maps — courses, travel, recruiting heat-maps) — RESERVED, NOT BUILT
# -----------------------------------------------------------------------------
# No `mapbox` package.json dependency and zero Mapbox references anywhere in
# src/ (verified 2026-07-09) — src/lib/mapbox/client.ts and
# src/components/maps/CourseMap.tsx do not exist. This section documents the
# intended future setup, not a live integration: free tier would be 50K map
# loads/month for Web SDK, 25K monthly active users on Mobile (Capacitor).
# If/when built: sign up at https://account.mapbox.com → tokens page →
# create a public token scoped to styles:read, fonts:read, tilesets:read.
# The public token ships to the browser — fine since scoping prevents abuse.
# Restrict by URL (helmsportslabs.com, *.vercel.app) in the Mapbox dashboard.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ---- GolfHelm UI Screenshots ----
GOLFHELM_PLAYER_EMAIL=
GOLFHELM_PLAYER_PASSWORD=
GOLFHELM_COACH_EMAIL=
GOLFHELM_COACH_PASSWORD=
GOLFHELM_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GolfHelm Public Demo Gate — shared demo coach account (SERVER-ONLY)
# -----------------------------------------------------------------------------
# A single shared coach account that every demo visitor is auto-signed into.
# The credentials are never sent to the client; the gate server action signs
# the visitor in server-side and sets the session cookie.
# Planned values:
#   DEMO_COACH_EMAIL=demo-coach@helmsportslabs.com
#   DEMO_COACH_PASSWORD=<random-strong-string-generated-at-setup>
# Set these in Vercel env → Production + Preview (Server-only — do NOT prefix
# with NEXT_PUBLIC_). The account must already exist in Supabase auth.users
# with a golf_coaches row (onboarding_completed=true) and a
# golf_team_coach_staff row for DEMO_TEAM_ID before enabling the gate.
DEMO_COACH_EMAIL=
DEMO_COACH_PASSWORD=

# -----------------------------------------------------------------------------
# BaseballHelm Public Demo Gate — kill-switch + shared coach account
# (SERVER-ONLY)
# -----------------------------------------------------------------------------
# The baseball equivalent of the GolfHelm block above. It was undocumented
# here, which matters most for the kill-switch: the answer to "how do I turn
# the public demo off right now?" lived only in
# src/lib/demo/baseball-config.server.ts.
#
# BASEBALL_DEMO_ENABLED — incident-response kill-switch for /baseball/demo.
#   DEFAULTS TO ENABLED. Set to false / 0 / off / no to disable without
#   touching credentials or redeploying; the gate page then renders its
#   "demo is resting" state up front instead of failing after form submit.
BASEBALL_DEMO_ENABLED=
#
# DEMO_BASEBALL_COACH_EMAIL / DEMO_BASEBALL_COACH_PASSWORD — the shared coach
#   account every demo visitor is signed into, server-side. Credentials never
#   reach the client.
#
#   BOTH ARE OPTIONAL AND BOTH HAVE FALLBACKS: when unset, the app uses the
#   deterministic values scripts/seed-baseball-demo.ts creates, which are
#   literals in the repo. That is deliberate (the seed and the gate must agree
#   or the demo cannot sign in) and it is safe because demo-session detection
#   is by EMAIL, not by how you signed in — someone logging in directly at
#   /baseball/login with the seed credentials is still resolved as a demo
#   session and still has every mutation blocked by withBaseballAction.
#
#   Set them in production anyway if you would rather the public demo account's
#   password not be readable in the source tree.
DEMO_BASEBALL_COACH_EMAIL=
DEMO_BASEBALL_COACH_PASSWORD=

# -----------------------------------------------------------------------------
# BaseballHelm stats seed script (scripts/seed-baseball-stats.mjs) — Optional
# -----------------------------------------------------------------------------
# Dry-run by default; only used to target a team/coach when running the
# script with --confirm. Can also be passed as --team / --coach CLI flags
# instead of being set here. See the script's header comment and
# docs/operations/2026-06-30-baseball-stats-seed-key-rotation.md.
# SEED_TEAM_ID=
# SEED_COACH_ID=

# -----------------------------------------------------------------------------
# One-off diagnostic / demo-seed scripts (scripts/*.ts, *.mjs) — Optional
# -----------------------------------------------------------------------------
# These scripts talk directly to Supabase with the service-role key and are
# NEVER meant to hardcode credentials (#516 P0 — see
# docs/operations/2026-07-03-p0-service-role-key-rotation-runbook.md). Set
# only what a given script needs; each fails fast with a clear message if a
# required var is missing.
#
# scripts/check-rls.ts, scripts/diagnose-rls.ts — real login used to exercise
# RLS as an authenticated player. Point this at a disposable test/demo
# account, never a real user's credentials.
RLS_DIAGNOSTIC_TEST_EMAIL=
RLS_DIAGNOSTIC_TEST_PASSWORD=
#
# scripts/seed-rini-baseball-demo.ts — sets real auth passwords for the
# developer's own demo coach/player/filler accounts. Required (--confirm
# writes will refuse to run without them).
# RINI_DEMO_COACH_PASSWORD=
# RINI_DEMO_PLAYER_PASSWORD=
# RINI_DEMO_FILLER_PASSWORD=
# HELM_ADMIN_SETUP_EMAIL=
# HELM_ADMIN_SETUP_PASSWORD=
# IOS_ITINERARY_TEST_EMAIL=
# IOS_ITINERARY_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# Fairway redesign feature flag (REMOVED — Wave W1, 2026-07-09)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_REDESIGN used to gate the "Fairway" warm-premium design system
# (see ui-intelligence/DESIGN-SYSTEM.md). Fairway is now the only dashboard
# tree — src/lib/redesign/flag.ts's isRedesignEnabled()/useRedesign() are
# hardcoded true — so this env var no longer has any effect. No action needed.

# -----------------------------------------------------------------------------
# CoachHelm — daily LLM budget fallback
# -----------------------------------------------------------------------------
# Per-coach daily spend ceiling used when a team has NOT configured its own
# `golf_coachhelm_settings.llm_budget_usd_per_day`. Unset means $3.00.
#
# It exists because "nobody has configured this team" used to resolve to $0,
# which is indistinguishable from "switched off on purpose" — and that state
# covered eight of thirteen production teams, every one of whom would have hit
# a hard failure on their first question. An unconfigured team should get a
# working product with a ceiling. A team that genuinely wants CoachHelm off
# sets its own budget to 0, which IS honoured and reported as a decision.
#
# Measured: one chat turn on Sonnet 5 with tool calls costs ~$0.045, so $3.00
# is roughly 65 questions a day.
# COACHHELM_DEFAULT_DAILY_BUDGET_USD=3
