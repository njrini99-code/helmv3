# =============================================================================
# Helm Sports Labs - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Production/Remote Supabase (Recommended for deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Development (Optional - comment out production URLs above)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Application Configuration (REQUIRED)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Helm Sports Labs

# Development Mode (Disable in production!)
NEXT_PUBLIC_DEV_MODE=false

# -----------------------------------------------------------------------------
# Tambo AI (for GolfHelm generative UI)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TAMBO_API_KEY=your-tambo-api-key-here

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (REQUIRED for Production)
# -----------------------------------------------------------------------------
# Get these from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ORG=your-org-name
SENTRY_PROJECT=your-project-name
# Dedicated read token for Helm Bridge issue/stats queries.
# Required scopes: org:read, project:read, event:read.
SENTRY_READ_TOKEN=your-sentry-read-token-here
# CI/source-map upload token. Helm Bridge only falls back to this when
# SENTRY_READ_TOKEN is absent and the token has the read scopes above.
SENTRY_AUTH_TOKEN=your-auth-token-here

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CAMPS=true
# NEXT_PUBLIC_ENABLE_MESSAGING=true

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Svix webhook signing secret. Verifies BOTH the outbound tracking webhook
# (/api/webhooks/resend — delivery/open/click/bounce/complaint/unsubscribe) and
# the inbound reply webhook (/api/webhooks/resend-inbound — email.received).
# Get from: https://resend.com/webhooks → your webhook → signing secret.
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- CRM cold-outreach From/identity (admin send-email + sequence cron) ---
# Primary From for CRM sends and the founder signature block. Falls back to
# 'Helm Sports Labs <admin@helmsportslabs.com>' if unset.
HELM_FROM_EMAIL=Helm Sports Labs <admin@helmsportslabs.com>
# Reply-To for cold outreach (defaults to HELM_FROM_EMAIL when unset).
HELM_REPLY_TO=admin@helmsportslabs.com
# Bare domain used to build links + the founder signature footer (no scheme).
HELM_DOMAIN=helmsportslabs.com
# Absolute URL of the logo embedded in the branded email footer.
HELM_LOGO_URL=https://helmsportslabs.com/helm-golf-logo-transparent.png
# Human signature line printed under the logo in outbound CRM email.
HELM_FOUNDER_LINE=Leah Potter & Nick Rini
# mailto: address used for the RFC 8058 List-Unsubscribe mailto fallback.
HELM_UNSUB_EMAIL=admin@helmsportslabs.com

# --- One-click unsubscribe (RFC 8058) token signing ---
# HMAC key for the List-Unsubscribe token in cold outreach. MUST be set to a
# strong random value in production (e.g. `openssl rand -hex 32`) AND match
# scripts/process-sequence-batch.mjs. The code defaults to the hardcoded string
# 'helm-sports-unsub-v1' so it works out-of-the-box in dev — but leaving that
# default in prod makes unsubscribe tokens forgeable (anyone can suppress any
# coach by guessing the public UUID). Always override in prod + preview. (G8)
CRM_UNSUB_SECRET=replace-with-strong-random-value-in-prod

# -----------------------------------------------------------------------------
# Gmail API direct send (OPTIONAL — for cold outreach via the real mailbox)
# -----------------------------------------------------------------------------
# When ALL THREE of GMAIL_SA_CLIENT_EMAIL + GMAIL_SA_PRIVATE_KEY + GMAIL_SEND_AS
# are set, the CRM "Gmail" buttons SEND cold email straight through your Google
# Workspace mailbox (Gmail API), not Resend — which lands in Primary far more
# reliably for 1:1 cold outreach. Leave them unset and nothing changes: the
# "Gmail" buttons keep opening a pre-filled compose tab (the existing flow).
#
# One-time setup (Google Cloud service account + Workspace domain-wide
# delegation, ~15 min): see docs/setup/gmail-send-setup.md.
#
# Service-account email (…@<project>.iam.gserviceaccount.com).
GMAIL_SA_CLIENT_EMAIL=
# The SA's PEM private key. Paste the whole "-----BEGIN PRIVATE KEY-----…"
# block; \n-escaped (single-line) is fine — the code restores the newlines.
GMAIL_SA_PRIVATE_KEY=
# Mailbox to impersonate / send as (must be a real Workspace user).
GMAIL_SEND_AS=admin@helmsportslabs.com
# Optional display name on the From header (defaults to "Nick Rini").
HELM_FROM_NAME=Nick Rini
# Optional safety cap on Gmail-API sends per calendar day (default 50). Keep
# this conservative — bursts from a real mailbox are the #1 way to get a
# Workspace account throttled or flagged for outbound spam.
GMAIL_DAILY_CAP=50

# --- Transactional/notification From addresses (non-CRM) ---
# Generic notifications From (task reminders, CoachHelm digests foundation).
# Falls back to 'Helm Sports <notifications@helmsportslabs.com>' when unset.
FROM_EMAIL=Helm Sports <notifications@helmsportslabs.com>
# From address for the weekly coach digest email (resend-client.ts).
RESEND_COACH_DIGEST_FROM=Helm Sports <notifications@helmsportslabs.com>
# From address for team-invite emails (team-invite.ts).
RESEND_TEAM_INVITE_FROM=Helm Sports <notifications@helmsportslabs.com>

# -----------------------------------------------------------------------------
# Web Push (VAPID) — used for browser push notifications
# -----------------------------------------------------------------------------
# Generate with:  npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the client; the PRIVATE key is server-only.
# Subject is the contact URL/mailto required by the Web Push spec (RFC 8292).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BD...your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:admin@helmsportslabs.com

# -----------------------------------------------------------------------------
# GrowthBook — feature flags + experiment rollout (v3)
# -----------------------------------------------------------------------------
# Get from: https://app.growthbook.io/settings/keys
# Server-evaluated; never expose the client key to the browser.
# GROWTHBOOK_API_HOST=https://cdn.growthbook.io
# GROWTHBOOK_CLIENT_KEY=sdk-your-sdk-key

# Legacy SMTP (not used — Resend is the active provider)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@helmlab.com
# SMTP_FROM_NAME=Helm Sports Labs

# -----------------------------------------------------------------------------
# Uploadthing Configuration (Optional - for file uploads)
# -----------------------------------------------------------------------------
# UPLOADTHING_SECRET=sk_live_your-secret-key
# UPLOADTHING_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# Stripe Configuration (Optional - for payments/subscriptions)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
# STRIPE_SECRET_KEY=sk_live_your-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# -----------------------------------------------------------------------------
# API Keys (Optional - for integrations)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key
# CLAUDE_API_KEY=your-claude-api-key

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# ANALYZE=false  # Set to 'true' to analyze bundle size
# NODE_ENV=production  # Automatically set by Vercel/deployment platform

# -----------------------------------------------------------------------------
# Vercel Analytics (Business Intelligence Dashboard)
# -----------------------------------------------------------------------------
# Get API token from: https://vercel.com/account/tokens
# Project ID and Team ID from: .vercel/project.json
VERCEL_API_TOKEN=your-vercel-api-token-here
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# -----------------------------------------------------------------------------
# Inngest (Durable workflows — replaces scattered cron + retry loops)
# -----------------------------------------------------------------------------
# Free tier: 50K step runs/month, 5 concurrent functions.
# Sign up at https://app.inngest.com → create an app named "helmv3" →
# copy these from the app's Keys page. Local dev does not require them
# (the dev server auto-discovers /api/inngest).
# INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=signkey-prod-your-key

# -----------------------------------------------------------------------------
# Mapbox (Maps — courses, travel, recruiting heat-maps)
# -----------------------------------------------------------------------------
# Free tier: 50K map loads/month for Web SDK, 25K monthly active users
# on Mobile (Capacitor). Sign up at https://account.mapbox.com → tokens
# page → create a public token scoped to styles:read, fonts:read,
# tilesets:read. The public token ships to the browser — fine since
# scoping prevents abuse. Restrict by URL (helmsportslabs.com, *.vercel.app)
# in the Mapbox dashboard.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ---- GolfHelm UI Screenshots ----
GOLFHELM_PLAYER_EMAIL=
GOLFHELM_PLAYER_PASSWORD=
GOLFHELM_COACH_EMAIL=
GOLFHELM_COACH_PASSWORD=
GOLFHELM_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GolfHelm Public Demo Gate — shared demo coach account (SERVER-ONLY)
# -----------------------------------------------------------------------------
# A single shared coach account that every demo visitor is auto-signed into.
# The credentials are never sent to the client; the gate server action signs
# the visitor in server-side and sets the session cookie.
# Planned values:
#   DEMO_COACH_EMAIL=demo-coach@helmsportslabs.com
#   DEMO_COACH_PASSWORD=<random-strong-string-generated-at-setup>
# Set these in Vercel env → Production + Preview (Server-only — do NOT prefix
# with NEXT_PUBLIC_). The account must already exist in Supabase auth.users
# with a golf_coaches row (onboarding_completed=true) and a
# golf_team_coach_staff row for DEMO_TEAM_ID before enabling the gate.
DEMO_COACH_EMAIL=
DEMO_COACH_PASSWORD=

# -----------------------------------------------------------------------------
# BaseballHelm stats seed script (scripts/seed-baseball-stats.mjs) — Optional
# -----------------------------------------------------------------------------
# Dry-run by default; only used to target a team/coach when running the
# script with --confirm. Can also be passed as --team / --coach CLI flags
# instead of being set here. See the script's header comment and
# docs/operations/2026-06-30-baseball-stats-seed-key-rotation.md.
# SEED_TEAM_ID=
# SEED_COACH_ID=

# -----------------------------------------------------------------------------
# One-off diagnostic / demo-seed scripts (scripts/*.ts, *.mjs) — Optional
# -----------------------------------------------------------------------------
# These scripts talk directly to Supabase with the service-role key and are
# NEVER meant to hardcode credentials (#516 P0 — see
# docs/operations/2026-07-03-p0-service-role-key-rotation-runbook.md). Set
# only what a given script needs; each fails fast with a clear message if a
# required var is missing.
#
# scripts/check-rls.ts, scripts/diagnose-rls.ts — real login used to exercise
# RLS as an authenticated player. Point this at a disposable test/demo
# account, never a real user's credentials.
RLS_DIAGNOSTIC_TEST_EMAIL=
RLS_DIAGNOSTIC_TEST_PASSWORD=
#
# scripts/seed-rini-baseball-demo.ts — sets real auth passwords for the
# developer's own demo coach/player/filler accounts. Required (--confirm
# writes will refuse to run without them).
# RINI_DEMO_COACH_PASSWORD=
# RINI_DEMO_PLAYER_PASSWORD=
# RINI_DEMO_FILLER_PASSWORD=

# -----------------------------------------------------------------------------
# Fairway redesign feature flag
# -----------------------------------------------------------------------------
# Gates the "Fairway" warm-premium design system (see ui-intelligence/
# DESIGN-SYSTEM.md). Default OFF — the current app is 100% unchanged; only
# redesigned components that opt in via src/lib/redesign/flag.ts + the
# `.fairway-ds` scope consume the new tokens/fonts. Accepts 1/true/on/yes.
# NEXT_PUBLIC_REDESIGN=false
