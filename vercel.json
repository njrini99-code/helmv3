{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false
    }
  },
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/coachhelm-validation",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/coachhelm-calibration",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/coachhelm-safety-net",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/coachhelm-insight-lifecycle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/coachhelm-roster-sweep",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/coach-morning-digest",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/v3/standing-refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/v3/genome-nightly",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/v3/causality-attribute",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/v3/weekly-coach-email",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/v3/goal-suggestions-write",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/v3/goal-suggestions-evaluate",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/integrity-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/log-retention",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/admin-digest",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/refresh-engagement",
      "schedule": "*/5 * * * *"
    }
  ]
}
