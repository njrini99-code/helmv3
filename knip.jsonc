// knip configuration.
//
// THIS FILE IS .jsonc DELIBERATELY. It was knip.json with the notes below
// stored in a "_comment" key, which knip 5.88.1 rejects outright:
//     ERROR: Invalid input (unrecognized_keys: _comment)   exit 2
// CircleCI ran it as `npx knip ... || true`, so the job posted green while
// the tool never started. The dead-code gate had never once run.
// Keep the notes as // comments; do not reintroduce a "_comment" key.
//
// Entry points must be ONLY the files Next.js reaches by FILE POSITION.
// This config previously listed 'src/app/**' as entry. An entry point is
// reachable by definition, so knip structurally could not report anything
// under src/app -- which is most of the codebase. It reported 7 unused
// files. With real entry points it reports 86. src/components/ui/** was
// additionally in 'ignore', hiding 18 more.
// Do not add a broad glob here to quiet the output. A broad entry glob does
// not fix findings, it hides them.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}",
    "src/app/**/route.{ts,tsx}",
    "src/app/**/loading.{ts,tsx}",
    "src/app/**/error.{ts,tsx}",
    "src/app/**/global-error.{ts,tsx}",
    "src/app/**/not-found.{ts,tsx}",
    "src/app/**/template.{ts,tsx}",
    "src/app/**/default.{ts,tsx}",
    "src/app/**/opengraph-image.{ts,tsx}",
    "src/app/**/twitter-image.{ts,tsx}",
    "src/app/**/icon.{ts,tsx}",
    "src/app/**/apple-icon.{ts,tsx}",
    "src/app/**/sitemap.ts",
    "src/app/**/robots.ts",
    "src/app/**/manifest.ts",
    "src/middleware.{ts,tsx}",
    "src/instrumentation.{ts,tsx}",
    "src/instrumentation-client.{ts,tsx}",
    "next.config.mjs",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.spec.{ts,tsx}",
    "src/test/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ]
}
