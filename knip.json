{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,route,template,not-found}.{ts,tsx}",
    "src/app/**/actions/**/*.ts",
    "src/contracts/**/*.ts",
    "scripts/**/*.mjs",
    "e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "e2e/**/*.ts"],
  "ignore": [
    "docs/operations/generated/**",
    "playwright-report/**",
    "test-results/**",
    ".next/**"
  ]
}
