# nothing under ui-intelligence/ is tracked, so the whole dir is ignored.)
# Leading slash anchors to repo root so it does NOT match scripts/ui-intelligence/
# (genuine tooling referenced by package.json).
/ui-intelligence/

# ── Repo hygiene (2026-06-02): stray tsc output + local artifacts ─────────────
# Stray compiled JS that a `tsc` (run without --noEmit) emitted next to tracked
# .ts/.tsx source. The .js were deleted; ignore so a stray compile can't dirty
# the tree again. Canonical source is always the .ts/.tsx.
/vitest.config.js
/tailwind.config.js
/playwright.config.js
/capacitor.config.js
/middleware.js
e2e/**/*.js
scripts/*.js
scripts/ui-intelligence/*.js
supabase/functions/**/*.js
landing/**/*.js
helm-intelligence/typescript/*.js
playwright/*.js

# Credential/PII-bearing demo scripts — never commit (owner keeps them locally).
scripts/provision-demo-accounts.mjs
scripts/rotate-demo-passwords.mjs

# Local design/screenshot dev scratch (keep the accumulated memory/*.json).
#
# The previous pattern was `.helmdev/*`. A pattern containing a slash is
# ANCHORED to the .gitignore's directory, so that only ever matched a root
# `.helmdev/` -- which does not exist. tools/ux-flow-auditor writes to the
# project root, but its output actually landed in `src/.helmdev/`, which the
# anchored pattern could not see. Result: neither the ignore NOR its
# `!memory/` exception ever matched anything, and 90 run-output files were
# tracked under src/ for months. `**/` makes it match at any depth.
**/.helmdev/*
!**/.helmdev/memory/

# Generated route-atlas + imported wiki dump (regenerated by `npm run ui:routes`).
/routes/

# Test-runner output.
/test-results/
/playwright-report/

# Large generated showcase binaries (repo already ignores GolfHelm-Prospect-Deck.pptx).
GolfHelm-CoachHelm-Showcase.pdf
GolfHelm-Fairway-Guide.pdf
statsfixresults.pdf

# Local Playwright screenshot artifacts
e2e-screenshots/
.bugtest-screens/

# Android upload keystore — NEVER commit
*.keystore
*.jks
android/keystore.properties

# Local-only working folders (2026-08-03 tidy).
#
# The repo root had accumulated 99 loose dev screenshots plus zips, PDFs and
# decks — all already ignored individually, so git never saw them, but they
# made the root unreadable. They now live in one place each rather than
# scattered across the top level.
.dev-screenshots/
.dev-assets/

# session/tool artifacts (added 2026-08-15)
.ultracode/
.claude/*.bak-*
SECURITY_REVIEW_*.json

# GolfHelm Engineering OS session-state (per-session JSONL; Phase 2 of the
# engineering-OS build writes here, added ahead of that so the path is never
# accidentally tracked once it starts).
.claude/session-state/

# Per-machine Claude Code settings. This lived only in ~/.config/git/ignore,
# which does not travel with the repo — so a fresh clone, a worktree, or CI
# had no rule at all. That gap is how a 93-entry shell allowlist
# (.claude/settings.local.json.bak-bbcc) reached this public repo and stayed
# tracked for weeks: the .bak-* rule above was added later, and gitignore
# never untracks a file that is already tracked.
.claude/settings.local.json
.claude/settings.local.json.*

# Generated by `npm run typecheck:functions` (deno check). Not a manifest for
# anything we ship — the edge functions declare imports inline and CI
# regenerates it every run. Ignored so the gate never leaves the tree dirty,
# which would trip deploy-prod.sh's dirty-tree guard and block a deploy.
deno.lock

# Real product asset. The blanket *.png rule above hid it from git while three
# live Lift Lab pages referenced it (login, forgot-password, coach onboarding),
# so it existed on exactly one machine. Scratch/screenshot PNGs stay ignored.
!public/helm-lifting-logo.png

# Python bytecode. Three .pyc files under tools/ were tracked until 2026-08-19
# with no ignore rule covering them, so every run of those scripts dirtied the
# tree and the compiled bytecode of a 3.14 interpreter was in version control.
__pycache__/
*.pyc
*.pyo
# Env files: explicit list, NOT a bare .env* — a blanket glob silently
# blocks future templates like .env.example (tracked) from ever changing
# hands without -f. Local secret files only.
.env
.env.local
.env.*.local
# Orphaned agent-framework state (untracked 2026-08-26): stale
# UNDERSTANDING/ISSUES/spec files that read as authoritative but are not.
# The canonicality rule in AGENTS.md is the durable statement; this makes
# it mechanical. Files remain on disk; also excluded from search via .ignore.
.helm/
.ultracode/
.superpowers/

# Momentic MCP scratch — screenshots, videos, captured env. Never track:
# a background scan found captured credentials in the env JSONs (never
# committed), and screenshots of auth flows are risky to publish.
.momentic-mcp/
tests/**/.momentic-mcp/

# Tool caches and one-off scan output that regenerate on demand. Neither was
# ignored, so both showed up as untracked noise in every `git status` and in
# agent file search (2026-08-27).
.ruff_cache/
CLAUDE-SECURITY-*/

# Local output of `npm run knowledge:report`. It is a CI artifact directory
# (feature-awareness.yml uploads it), and neither it nor its changed-files
# input was ignored — so running the report locally left untracked files in the
# repo. Added 2026-08-27 alongside the usage message that now tells people to
# run it locally, which made that more likely rather than less.
feature-awareness-report/
changed-files.txt
