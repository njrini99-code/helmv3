*.png
# Hosted email assets must reach prod — exempt them from the global *.png ignore.
!public/email/*.png
# QA visual audit packs (labeled screenshots + manifests)
!docs/qa/**/*.png
# Android launcher icons are build inputs — without these the adaptive icon's
# @mipmap/ic_launcher_foreground does not resolve on a fresh clone and the
# Gradle build FAILS. The generated vector defaults were removed in favour of
# real branded PNGs, so these must be tracked.
!android/app/src/main/res/**/*.png
# Play Store listing assets (feature graphic, 512 icon, phone screenshots) —
# deliverables, not scratch. Needs ** to reach assets/screenshots/, a single *
# only matches direct children.
!android/playstore/assets/**/*.png
GolfHelm-Prospect-Deck.pptx
.claude/worktrees/

# Context7 MCP config — contains secret api_key, see context7.json.example
context7.json

# Local agent/codex tooling (machine-specific, not shared)
.agents/
.codex/

# Ultracode append-only logs (machine-specific; state JSON may stay tracked)
.ultracode/**/events.ndjson
.ultracode/**/*.log

# Local hygiene / audit runs (regenerated)
.cleanup/

# Ops audit outputs (regenerated by CI/scripts)
docs/operations/generated/

# ignore a root node_modules SYMLINK too (the "node_modules/" dir pattern misses symlinks)
node_modules

# GolfHelm UI screenshots
# Auth storage states (contain Supabase session cookies — never commit)
playwright/.auth/
/momentic/auth/*.json
/momentic/auth/.momentic.env
!/momentic/auth/.gitkeep
# Local product-audit browser states use several historical layouts. Keep the
# generated JSON out of Git even when an audit writes outside playwright/.auth/.
/audit/**/auth/*.json
/audit/**/auth-local/*.json
/audit/**/*-auth.json
/audit/**/authsmoke-*.json
# Captured UI-atlas artifacts — large, fully regenerated by `npm run ui:*`.
# (The earlier "index.html/catalog.json stay tracked" note was never realized —
# nothing under ui-intelligence/ is tracked, so the whole dir is ignored.)
# Leading slash anchors to repo root so it does NOT match scripts/ui-intelligence/
# (genuine tooling referenced by package.json).
/ui-intelligence/

# ── Repo hygiene (2026-06-02): stray tsc output + local artifacts ─────────────
# Stray compiled JS that a `tsc` (run without --noEmit) emitted next to tracked
# .ts/.tsx source. The .js were deleted; ignore so a stray compile can't dirty
# the tree again. Canonical source is always the .ts/.tsx.
/vitest.config.js
/tailwind.config.js
/playwright.config.js
/capacitor.config.js
/middleware.js
e2e/**/*.js
scripts/*.js
scripts/ui-intelligence/*.js
supabase/functions/**/*.js
helm-website-ui/**/*.js
landing/**/*.js
helm-intelligence/typescript/*.js
playwright/*.js

# Credential/PII-bearing demo scripts — never commit (owner keeps them locally).
scripts/provision-demo-accounts.mjs
scripts/rotate-demo-passwords.mjs

# Local design/screenshot dev scratch (keep the already-tracked .helmdev/memory/*.json).
.helmdev/*
!.helmdev/memory/

# Generated route-atlas + imported wiki dump (regenerated by `npm run ui:routes`).
/routes/

# Test-runner output.
/test-results/
/playwright-report/

# Large generated showcase binaries (repo already ignores GolfHelm-Prospect-Deck.pptx).
GolfHelm-CoachHelm-Showcase.pdf
GolfHelm-Fairway-Guide.pdf
statsfixresults.pdf

# Local Playwright screenshot artifacts
e2e-screenshots/
.bugtest-screens/

# Android upload keystore — NEVER commit
*.keystore
*.jks
android/keystore.properties

# Local-only working folders (2026-08-03 tidy).
#
# The repo root had accumulated 99 loose dev screenshots plus zips, PDFs and
# decks — all already ignored individually, so git never saw them, but they
# made the root unreadable. They now live in one place each rather than
# scattered across the top level.
.dev-screenshots/
.dev-assets/

# session/tool artifacts (added 2026-08-15)
.ultracode/
.claude/*.bak-*
SECURITY_REVIEW_*.json

# Per-machine Claude Code settings. This lived only in ~/.config/git/ignore,
# which does not travel with the repo — so a fresh clone, a worktree, or CI
# had no rule at all. That gap is how a 93-entry shell allowlist
# (.claude/settings.local.json.bak-bbcc) reached this public repo and stayed
# tracked for weeks: the .bak-* rule above was added later, and gitignore
# never untracks a file that is already tracked.
.claude/settings.local.json
.claude/settings.local.json.*
