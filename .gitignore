# Next.js
.next/
.next
out/
# Regenerated by every `next dev`/`next build`/`next lint` run (dev vs build
# mode reference different .next/types paths, so it churns constantly even
# with no real source change). Next.js recreates it automatically if
# missing — see docs/operations/GENERATED_FILE_POLICY.md.
next-env.d.ts

# Worktree build-cache symlinks (machine-specific; never commit)
.bin
.cache

