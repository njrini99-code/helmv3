{
  "name": "helmv3",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "audit:fail-open": "node scripts/fail-open-audit.mjs",
    "audit:paginated-reads": "node scripts/paginated-read-audit.mjs",
    "audit:supabase-errors": "node scripts/supabase-error-audit.mjs",
    "baseball:route-coverage": "tsx scripts/baseball/generate-route-coverage-report.ts",
    "build": "next build --webpack",
    "check": "npm run typecheck && npm run lint",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:env": "node scripts/check-required-env.mjs",
    "check:env-secrets": "node scripts/check-env-secret-fallbacks.mjs",
    "check:vercelignore": "node scripts/check-vercelignore-coverage.mjs",
    "check:helm-bridge-env": "node scripts/check-helm-bridge-env.mjs",
    "check:ledger": "node scripts/check-migration-ledger.mjs",
    "check:readiness-matrix": "tsx scripts/baseball/check-readiness-matrix.ts",
    "check:row-caps": "node scripts/check-row-cap-limits.mjs",
    "check:stats": "tsx -r dotenv/config scripts/verify-stats-consistency.ts",
    "check:types-drift": "bash scripts/check-types-drift.sh",
    "coachhelm:refresh": "bash scripts/coachhelm-refresh-all.sh",
    "coachhelm:regen": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/regen-coachhelm-from-corrected-stats.ts",
    "control-plane:verify": "node scripts/control-plane-verify.mjs",
    "control-plane:verify:static": "node scripts/control-plane-verify.mjs --static",
    "db:drift:check": "node scripts/db/check-supabase-drift.mjs",
    "db:ledger-drift": "node scripts/db/migration-ledger-drift.mjs",
    "db:types": "bash scripts/gen-db-types.sh",
    "db:types:check": "npm run db:types && git diff --exit-code src/lib/types/database.ts || (echo '❌ Types are out of date. Run npm run db:types and commit changes.' && exit 1)",
    "dev": "next dev",
    "docs:check": "npm run docs:inventory-check && npm run docs:schema-drift && npm run docs:path-drift && npm run enforcement:check && npm run tool-authority:check",
    "docs:inventory-check": "node scripts/regen-docs.mjs --check",
    "docs:path-drift": "node scripts/check-doc-path-drift.mjs",
    "docs:regen": "node scripts/regen-docs.mjs",
    "docs:schema-drift": "node scripts/check-doc-schema-drift.mjs",
    "doctor": "node scripts/doctor.mjs",
    "diagnostics:health": "node scripts/diagnostics-health.mjs",
    "enforcement:check": "node scripts/gen-enforcement-inventory.mjs --check",
    "enforcement:regen": "node scripts/gen-enforcement-inventory.mjs",
    "evals": "promptfoo eval -c evals/round-review.yaml",
    "evals:view": "promptfoo view",
    "flags:check": "node scripts/flags/generate-flags.mjs --check && node --test scripts/flags/__tests__/*.test.mjs scripts/__tests__/check-feature-flags.test.mjs && node scripts/check-feature-flags.mjs",
    "flags:generate": "node scripts/flags/generate-flags.mjs",
    "flight-recorder:audit": "node scripts/flight-recorder-audit.mjs",
    "guards": "node scripts/repo-guards.mjs",
    "knowledge:check": "node scripts/knowledge/check.mjs",
    "knowledge:context": "node scripts/knowledge/generate-context-pack.mjs",
    "knowledge:globs": "node scripts/check-registry-globs.mjs",
    "knowledge:authority-check": "node scripts/knowledge/check-authority.mjs",
    "knowledge:doc-inventory": "node scripts/knowledge/document-inventory.mjs",
    "knowledge:ledger-check": "node scripts/knowledge/check-ledger-integrity.mjs",
    "knowledge:feature-map": "tsx scripts/knowledge/gen-feature-map.ts",
    "knowledge:feature-map:check": "tsx scripts/knowledge/gen-feature-map.ts --check",
    "knowledge:registry-check": "tsx scripts/knowledge/check-feature-registry.ts",
    "knowledge:map": "node scripts/knowledge/map-changed-files.mjs",
    "knowledge:report": "node scripts/knowledge/workflow-report.mjs",
    "knowledge:journeys-check": "node scripts/knowledge/check-journeys.mjs",
    "knowledge:journeys-check:test": "node --test scripts/knowledge/__tests__/check-journeys.test.mjs",
    "knowledge:bench": "node scripts/knowledge/bench.mjs",
    "knowledge:bench:test": "node --test scripts/knowledge/__tests__/bench.test.mjs",
    "helm-os:check": "npm run docs:check && npm run knowledge:check",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:duplicate-exports": "node scripts/check-duplicate-exports.mjs",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "markdown:ratchet": "node scripts/markdown-lint-ratchet.mjs",
    "orphans:mounts": "node scripts/find-orphan-mounts.mjs",
    "postbuild": "node scripts/strip-next-tsconfig-injection.mjs",
    "prebuild": "node scripts/check-required-env.mjs && node scripts/stamp-sw.mjs",
    "preflight": "npm run typecheck && npm run lint && npm run lint:ratchet && npm run audit:supabase-errors && npm run audit:fail-open && npm run markdown:ratchet && npm run docs:schema-drift && npm run docs:path-drift && npm run knowledge:globs && npm run lint:duplicate-exports && npm run guards && echo 'PREFLIGHT GREEN — this is the blocking static set CI runs. Unit tests: npm test.'",
    "repo:doctor": "node scripts/repo-doctor/cli.mjs",
    "routes:hygiene:p0p1": "node scripts/check-route-hygiene-p0-p1.mjs",
    "schema": "node scripts/schema.mjs",
    "seed:baseball:ci": "tsx scripts/seed-baseball-demo.ts --confirm",
    "seed:baseball:demo": "tsx -r dotenv/config scripts/seed-baseball-demo.ts --confirm && tsx -r dotenv/config scripts/seed-baseball-lifting-demo.ts --confirm && tsx -r dotenv/config scripts/seed-baseball-surfaces-demo.ts --confirm && tsx -r dotenv/config scripts/seed-baseball-demo-program.ts --confirm && tsx -r dotenv/config scripts/verify-baseball-demo-coverage.ts",
    "seed:baseball:e2e": "tsx -r dotenv/config scripts/seed-baseball-e2e.ts",
    "selfheal:repair:doctor": "node scripts/selfheal-repair-doctor.mjs",
    "selfheal:repair:install": "bash scripts/selfheal-repair-install.sh",
    "sql:ratchet": "node scripts/sql-lint-ratchet.mjs",
    "start": "next start",
    "test": "vitest --project unit --project unit-dom",
    "test:all": "vitest run",
    "test:business": "vitest run --project business",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --project integration",
    "test:rls": "bash scripts/test-pgtap.sh",
    "test:run": "vitest run --project unit --project unit-dom",
    "test:ui": "vitest --ui",
    "tool-authority:check": "node scripts/gen-tool-authority.mjs --check",
    "tool-authority:regen": "node scripts/gen-tool-authority.mjs",
    "trace:db": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/trace-db.ts",
    "triage": "tsx -r dotenv/config scripts/run-triage.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "deno check --node-modules-dir=none --minimum-dependency-age=120 supabase/functions/*/index.ts",
    "ui:atlas": "tsx scripts/ui-intelligence/generate-atlas.ts",
    "ui:auth": "playwright test --config playwright/screenshots.config.ts",
    "ui:dataflow": "tsx scripts/ui-intelligence/generate-data-flow.ts",
    "ui:refresh": "node scripts/ui-intelligence/refresh-landed.mjs",
    "ui:routes": "tsx scripts/ui-intelligence/normalize-devin-routes.ts",
    "ui:screenshots": "npm run ui:routes && npm run ui:auth && npm run ui:screenshots:capture && npm run ui:screenshots:index",
    "ui:screenshots:capture": "tsx scripts/ui-intelligence/capture-desktop-screenshots.ts",
    "ui:screenshots:index": "tsx scripts/ui-intelligence/generate-screenshot-index.ts",
    "verify:business": "npm run test:business",
    "worktree:deps": "node scripts/ensure-worktree-deps.mjs",
    "worktrees": "node scripts/worktree-lifecycle.mjs",
    "worktrees:park": "node scripts/worktree-lifecycle.mjs --park",
    "worktrees:retire": "node scripts/worktree-lifecycle.mjs --retire",
    "workspace:clean": "node scripts/workspace-clean.mjs",
    "workspace:clean:apply": "node scripts/workspace-clean.mjs --apply",
    "release:status": "node scripts/release-status.mjs"
  },
