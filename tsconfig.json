{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "es2018",
    "types": ["vitest/globals"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  // `.next/types/**/*.ts` and `.next/dev/types/**/*.ts` were here and are
  // deliberately gone (2026-08-26).
  //
  // They gave NOTHING in CI and broke `npm run typecheck` for every local
  // session. In CI the typecheck job runs on a fresh checkout where `.next/`
  // does not exist, so both globs matched zero files. Locally `.next/` is
  // always present (dev server, or any build), so `tsc --noEmit` type-checked
  // Next's own generated `validator.ts` and failed with two errors that exist
  // nowhere else:
  //   .next/types/validator.ts: Type 'Route' does not satisfy the constraint 'never'
  // Measured that day: `tsc -p` with these globs = exit 2, without = exit 0,
  // on identical source.
  //
  // Every agent and developer running typecheck locally saw a red tree that CI
  // considered green, which is a standing invitation to chase a bug that is not
  // there. Generated-file coverage is NOT lost: `next.config.mjs` sets
  // `typescript.ignoreBuildErrors: false`, so `next build` type-checks its own
  // generated types itself — and passes with `.next/` present, which is exactly
  // the case raw `tsc` could not handle.
  "exclude": [
    "node_modules",
    "archive",
    "scripts",
    "supabase/functions",
    ".next",
    // replay/fixtures/**/*.test.ts(x) are inert snapshots of a repair's own
    // regression test, copied verbatim from a historical commit — their
    // relative imports (e.g. '../qualifier-lifecycle') resolve only once
    // replay/runners/run.mjs overlays them into a worktree checked out at
    // that commit, not in place under replay/fixtures/. See replay/README.md.
    "replay/fixtures"
  ]
}
