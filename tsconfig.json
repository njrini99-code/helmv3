{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "es2018",
    "types": [
      "vitest/globals"
    ],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `.next/types/**/*.ts` and `.next/dev/types/**/*.ts` above are INERT for
  // `tsc`: `exclude` below lists `.next`, and TypeScript applies `exclude` to
  // what `include` globs match, so neither glob contributes a file. Verified
  // 2026-10-06 with the locked TypeScript 5.9.3 (`tsc --listFilesOnly` on a
  // copy of this file): with `.next` excluded, generated files are not listed;
  // without it, `.next/types/validator.ts` is listed.
  //
  // WHY THIS MATTERS. Raw `tsc` must not type-check Next's generated
  // `validator.ts`: when `.next/` exists locally, it fails with
  //   .next/types/validator.ts: Type 'Route' does not satisfy the constraint 'never'
  // (measured 2026-08-26: exit 2 with those files checked, exit 0 without). In
  // CI the typecheck job runs on a fresh checkout with no `.next/`, so nothing
  // changes there.
  //
  // WHY THE GLOBS ARE STILL LISTED. `next build` re-adds them to `include`
  // whenever they are missing, and `scripts/strip-next-tsconfig-injection.mjs`
  // (postbuild) then reverts any build-only rewrite of this file. Leaving the
  // inert globs here keeps builds from dirtying the tree. Do not remove `.next`
  // from `exclude`; that would turn the globs on. Generated-file coverage is
  // not lost: `next.config.mjs` sets `typescript.ignoreBuildErrors: false`, so
  // `next build` type-checks its own generated types.
  "exclude": [
    "node_modules",
    "design",
    "archive",
    "scripts",
    "supabase/functions",
    ".next",
    // replay/fixtures/**/*.test.ts(x) are inert snapshots of a repair's own
    // regression test, copied verbatim from a historical commit — their
    // relative imports (e.g. '../qualifier-lifecycle') resolve only once
    // replay/runners/run.mjs overlays them into a worktree checked out at
    // that commit, not in place under replay/fixtures/. See replay/README.md.
    "replay/fixtures"
  ]
}
