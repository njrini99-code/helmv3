#!/bin/bash
# .githooks/pre-commit — fast local staged-diff hygiene.
#
# CI owns project-wide checks. Locally, scan staged content for secrets when
# gitleaks is installed and remind contributors that a migration requires the
# generated database types to be refreshed. This hook never reads credentials,
# calls a remote service, regenerates files, or stages files on its own.

set -uo pipefail

STAGED_FILES="$(git diff --cached --name-only)"

if command -v gitleaks >/dev/null 2>&1; then
  if [ -f ".gitleaks.toml" ]; then
    gitleaks protect --staged --redact --config .gitleaks.toml
  else
    gitleaks protect --staged --redact
  fi
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "pre-commit: gitleaks found a likely secret in the staged diff." >&2
    exit "$status"
  fi
else
  echo "pre-commit: gitleaks not on PATH — local secret scan skipped; CI still scans."
fi

if printf '%s\n' "$STAGED_FILES" | grep -Eq '^supabase/migrations/.*\.sql$'; then
  echo "pre-commit: migration staged — refresh src/lib/types/database.ts if the schema changed."
  echo "pre-commit: run 'npm run db:types' explicitly, review the diff, then stage the result."
fi

exit 0
