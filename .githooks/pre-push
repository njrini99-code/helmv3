#!/bin/bash
# .githooks/pre-push — nothing reaches GitHub that preflight has not passed.
#
# 1. Range-scoped hygiene on the pushed commits: `git diff --check` and, when
#    installed, a gitleaks scan of the same range.
# 2. `npm run preflight` (scripts/preflight.mjs, the local mirror of the
#    required CI checks) — skipped when its stamp already covers the pushed
#    tree, run in fast mode otherwise.
#
# Skip for a single push: HELM_SKIP_PREPUSH=1 git push

set -uo pipefail

if [ "${HELM_SKIP_PREPUSH:-0}" = "1" ]; then
  echo "pre-push: HELM_SKIP_PREPUSH=1 — local checks skipped; CI still runs."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
HOOK_START=$(date +%s)
STDIN_LINES=()

# Read every ref before invoking a subprocess. Git supplies one line per
# pushed ref on stdin, and a child process must not consume the remaining lines.
while IFS= read -r line; do
  [ -n "$line" ] && STDIN_LINES+=("$line")
done

if [ "${#STDIN_LINES[@]}" -eq 0 ]; then
  echo "pre-push: no ref updates on stdin — nothing to check."
  exit 0
fi

RANGES=()
FAILED=0

for line in "${STDIN_LINES[@]}"; do
  read -r local_ref local_sha _remote_ref remote_sha <<<"$line"

  # A zero local SHA means the remote ref is being deleted. There is no
  # pushed history to inspect.
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  base=""
  if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
    if [ -z "$base" ]; then
      base="$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -1)"
    fi
  fi

  if [ -z "$base" ]; then
    echo "pre-push: could not resolve a diff base for $local_ref — push aborted."
    FAILED=1
    continue
  fi

  RANGES+=("${base}..${local_sha}")
done

if [ "${#RANGES[@]}" -eq 0 ]; then
  echo "pre-push: no pushed commit ranges — nothing to check."
  exit "$FAILED"
fi

echo "pre-push: checking ${#RANGES[@]} pushed commit range(s)."

for range in "${RANGES[@]}"; do
  if git diff --check "$range" --; then
    echo "✓ git diff --check OK ($range)"
  else
    echo "✗ git diff --check FAILED ($range)"
    FAILED=1
  fi
done

if command -v gitleaks >/dev/null 2>&1; then
  for range in "${RANGES[@]}"; do
    if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
      gitleaks git --redact --config "$REPO_ROOT/.gitleaks.toml" --log-opts="$range" .
    else
      gitleaks git --redact --log-opts="$range" .
    fi
    status=$?
    if [ "$status" -eq 0 ]; then
      echo "✓ gitleaks OK ($range)"
    else
      echo "✗ gitleaks FAILED ($range)"
      FAILED=1
    fi
  done
else
  echo "pre-push: gitleaks not found — skipped (CI still scans)."
fi

# --- preflight: the local mirror of the required CI checks ------------------
# A green `npm run preflight` stamps the tree it tested
# (.helm/runtime/preflight.json). A pushed commit with exactly that tree goes
# straight through; otherwise, when the pushed commit is HEAD, run the fast
# preflight now. Skipped when the cheap checks above already failed.
PREFLIGHT="$REPO_ROOT/scripts/preflight.mjs"
STAMP_TOOL="$REPO_ROOT/scripts/lib/preflight-stamp.mjs"
if [ "$FAILED" -eq 0 ] && [ -f "$PREFLIGHT" ] && [ -f "$STAMP_TOOL" ]; then
  # Git hooks inherit a non-interactive PATH, which has resolved Homebrew's
  # newer Node before. Prefer the fnm default when it is the .nvmrc major.
  WANT_NODE=""
  [ -f "$REPO_ROOT/.nvmrc" ] && WANT_NODE="$(tr -dc '0-9' < "$REPO_ROOT/.nvmrc")"
  if [ -n "$WANT_NODE" ] && ! node -v 2>/dev/null | grep -q "^v${WANT_NODE}\."; then
    FNM_DEFAULT="$HOME/.local/share/fnm/aliases/default/bin"
    if [ -x "$FNM_DEFAULT/node" ] && "$FNM_DEFAULT/node" -v | grep -q "^v${WANT_NODE}\."; then
      PATH="$FNM_DEFAULT:$PATH"
      export PATH
    fi
  fi
  HEAD_SHA_NOW="$(git rev-parse HEAD)"
  for line in "${STDIN_LINES[@]}"; do
    read -r local_ref local_sha remote_ref _remote_sha <<<"$line"
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    if node "$STAMP_TOOL" verify "$local_sha" >/dev/null 2>&1; then
      echo "✓ preflight stamp matches ${local_sha:0:9} ($local_ref)"
      continue
    fi
    if [ "$local_sha" != "$HEAD_SHA_NOW" ]; then
      echo "✗ preflight: ${local_ref} (${local_sha:0:9}) is not the checked-out HEAD and has no green preflight."
      echo "  Check it out and run 'npm run preflight', then push again."
      FAILED=1
      continue
    fi
    echo "pre-push: no green preflight for ${local_sha:0:9} — running 'npm run preflight' (fast) now."
    if node "$PREFLIGHT" --fast; then
      if node "$STAMP_TOOL" verify "$local_sha" >/dev/null 2>&1; then
        echo "✓ preflight OK (${local_sha:0:9})"
      else
        echo "✗ preflight passed for the working tree, but it differs from the pushed commit ${local_sha:0:9}."
        echo "  Commit (or stash) the uncommitted edits so the tested tree is the pushed tree, then push again."
        FAILED=1
      fi
    else
      echo "✗ preflight FAILED — fix everything it reported in one batch before pushing."
      FAILED=1
    fi
  done
elif [ "$FAILED" -eq 0 ]; then
  echo "pre-push: scripts/preflight.mjs not on this branch — preflight skipped."
fi

TOTAL=$(( $(date +%s) - HOOK_START ))
echo "pre-push: total ${TOTAL}s."

if [ "$FAILED" -ne 0 ]; then
  echo "pre-push: local checks failed — push aborted."
  exit 1
fi

exit 0
